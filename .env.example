# Translation provider used by the phone before captions are sent to the TV.
#   mock           — built-in EN/ES/PT dictionary (default; works offline, no keys)
#   passthrough    — copies the spoken text into every language window
#   mymemory       — free public API, no key, rate-limited, needs network
#   libretranslate — self-hosted or hosted LibreTranslate
VITE_TRANSLATE_PROVIDER=mock

# LibreTranslate only (never commit real keys)
# VITE_LIBRETRANSLATE_URL=http://localhost:5000/translate
# VITE_LIBRETRANSLATE_API_KEY=
