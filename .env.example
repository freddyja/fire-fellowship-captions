# Server-side translation (used by npm start and Vite's /api/translate).
# Never commit real keys. The phone calls /api/translate — no VITE_* key.
#
#   deepl    — DeepL API (recommended meeting-night path). Free plan needs
#              DEEPL_AUTH_KEY from https://www.deepl.com/pro-api — no Google
#              billing admin. Default host is api-free.deepl.com.
#   mymemory — MyMemory. Free, no key. Used when a DeepL key is missing so
#              hosted demos still translate. Rate-limited.
#   mock     — built-in EN/ES/PT dictionary. Offline demo only.
#   google   — Google Cloud Translation API v2. Needs billing + API key.
#
# Recommended meeting night (DeepL Free — do not invent a key):
# TRANSLATE_PROVIDER=deepl
# DEEPL_AUTH_KEY=
# Optional Pro host (leave unset for Free; free keys end with :fx):
# DEEPL_API_URL=https://api-free.deepl.com
#
# No-key fallback / hosted demo without secrets:
# TRANSLATE_PROVIDER=mymemory
#
# Offline laptop demo:
# TRANSLATE_PROVIDER=mock
#
# Optional: raise MyMemory's daily cap (email, not an API key).
# MYMEMORY_EMAIL=
#
# Optional paid Google path (needs a GCP billing admin; leave unset otherwise):
# TRANSLATE_PROVIDER=google
# GOOGLE_TRANSLATE_API_KEY=

# Optional client-only overrides for local experiments. Leave unset so the phone
# uses the server (/api/translate). Never put DEEPL_AUTH_KEY in VITE_*.
# VITE_TRANSLATE_PROVIDER=passthrough
# VITE_MYMEMORY_EMAIL=
# VITE_LIBRETRANSLATE_URL=http://localhost:5000/translate
# VITE_LIBRETRANSLATE_API_KEY=
