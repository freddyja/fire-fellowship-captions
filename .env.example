# Server-side translation (used by npm start and Vite's /api/translate).
# Never commit real keys. The phone calls /api/translate — no VITE_* key.
#
#   mymemory — MyMemory (default). Free, no key. EN/ES/PT any direction.
#              Rate-limited (~5,000 chars/day per host IP). Meeting-night path
#              when Google billing is not available.
#   mock     — built-in EN/ES/PT dictionary. Offline demo only.
#   google   — Google Cloud Translation API v2. Needs billing + API key.
#              A billing admin must enable billing on the GCP project.
#
# Hosted / meeting night (no secrets required):
# TRANSLATE_PROVIDER=mymemory
#
# Offline laptop demo:
# TRANSLATE_PROVIDER=mock
#
# Optional: raise MyMemory's daily cap to ~50,000 chars (email, not an API key).
# MYMEMORY_EMAIL=
#
# Optional paid path (do not invent a key; leave unset if you cannot enable billing):
# TRANSLATE_PROVIDER=google
# GOOGLE_TRANSLATE_API_KEY=

# Optional client-only overrides for local experiments. Leave unset so the phone
# uses the server (/api/translate → MyMemory by default, Google if a key is set).
# VITE_TRANSLATE_PROVIDER=passthrough
# VITE_MYMEMORY_EMAIL=
# VITE_LIBRETRANSLATE_URL=http://localhost:5000/translate
# VITE_LIBRETRANSLATE_API_KEY=
